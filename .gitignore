# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project-local mysql instance
/.mysql/
!.env.example

# 备份文件含全部业务数据，绝不入库（生产由 docker-compose 挂到 ./backups）
/backups/

# 一次性验证脚本（我的排查/验收用）：绝不该进版本库。
# 曾经用 `git add -A` 误提交过三个，所以这里加一道防线。
/.wc-*

# 部署脚本的本地状态（scripts/deploy.sh 记录历史部署），各机器各自维护
/.deploy/
