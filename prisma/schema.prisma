// 进销存管理系统 数据模型
// 依据《进销存系统-需求与设计文档》第 6 章设计，v0.2 评审稿
// 说明：sessions 表为文档 8.1 会话需求（HttpOnly Cookie + 服务端可吊销）补充的表；
//       文档表清单未列出，属认证实现必需，已在 docs/细节评审.md 中记录。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 枚举
// ---------------------------------------------------------------------------

enum UserRole {
  admin // 管理员
  sales // 业务员
  boss // 老板/财务
}

enum PurchaseOrderStatus {
  pending // 待收货
  received // 已入库
  voided // 作废
}

enum SaleOrderStatus {
  confirmed // 已开单
  voided // 作废
}

enum ReturnOrderStatus {
  confirmed // 已开单
  voided // 作废
}

enum PaymentStatus {
  confirmed // 已登记
  voided // 作废（冲回单据收付金额）
}

enum SourceType {
  manual // 手动进货
  auto // 自动补货（由售卖单缺货触发）
}

enum PaymentDirection {
  receipt // 收款
  payment // 付款
}

enum PaymentOrderType {
  sale
  purchase
  sale_return
  purchase_return
}

enum PaymentMethod {
  cash
  bank
  wechat
  alipay
  other
}

enum StockBizType {
  purchase_in // 进货入库
  sale_out // 销售出库
  purchase_return_out // 进货退货出库
  sale_return_in // 销售退货入库
  void_reverse // 作废冲回
}

// ---------------------------------------------------------------------------
// 用户与安全
// ---------------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(50)
  role         UserRole
  status       Int       @default(1) // 1 启用 / 0 停用
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  loginLogs       LoginLog[]
  auditLogs       AuditLog[]
  createdProducts Product[]        @relation("ProductCreator")
  purchaseOrders  PurchaseOrder[]
  saleOrders      SaleOrder[]
  purchaseReturns PurchaseReturn[]
  saleReturns     SaleReturn[]
  payments        Payment[]

  @@map("users")
}

// 服务端会话：cookie 中存放随机 token，库中仅存 token 哈希，
// 登出/过期即删行，实现"登出即失效"。
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.Char(64) // sha256 hex
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  username  String   @db.VarChar(50) // 尝试登录的账号（失败时 userId 可能为空）
  success   Boolean
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, success, createdAt])
  @@index([username, createdAt])
  @@map("login_logs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id") // 登录失败等场景可为空
  user       User?    @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(50) // login / create / receive / void / update / delete
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   BigInt?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 基础资料
// ---------------------------------------------------------------------------

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(20)
  status    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products            Product[]
  purchaseOrderItems  PurchaseOrderItem[]
  saleOrderItems      SaleOrderItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleReturnItems     SaleReturnItem[]

  @@map("units")
}

model ProductCategory {
  id        Int               @id @default(autoincrement())
  name      String            @db.VarChar(50)
  parentId  Int?              @map("parent_id") // 预留树形，一期只用一级
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  status    Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id               Int              @id @default(autoincrement())
  code             String           @unique @db.VarChar(20) // 自动 SKU，如 P000001
  name             String           @db.VarChar(100)
  spec             String?          @db.VarChar(100)
  manufacturer     String           @default("") @db.VarChar(100) // 厂商（生产厂家，必填——应用层强制）
  categoryId       Int?             @map("category_id")
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  unitId           Int              @map("unit_id")
  unit             Unit             @relation(fields: [unitId], references: [id])
  refPurchasePrice Decimal          @map("ref_purchase_price") @db.Decimal(12, 2) // 参考进价
  refSalePrice     Decimal          @map("ref_sale_price") @db.Decimal(12, 2) // 参考售价
  minStock         Decimal          @default(0) @map("min_stock") @db.Decimal(12, 3) // 预警线
  stockQty         Decimal          @default(0) @map("stock_qty") @db.Decimal(12, 3) // 当前库存（冗余，事务内维护）
  stockAmount      Decimal          @default(0) @map("stock_amount") @db.Decimal(14, 2) // 库存成本金额
  avgCost          Decimal          @default(0) @map("avg_cost") @db.Decimal(12, 4) // 移动加权平均成本
  status           Int              @default(1)
  createdBy        Int?             @map("created_by")
  creator          User?            @relation("ProductCreator", fields: [createdBy], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  stockMovements      StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]
  saleOrderItems      SaleOrderItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleReturnItems     SaleReturnItem[]

  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model Supplier {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  contact         String?          @db.VarChar(50)
  phone           String?          @db.VarChar(30)
  address         String?          @db.VarChar(200)
  remark          String?          @db.VarChar(200)
  status          Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@index([name])
  @@map("suppliers")
}

model Customer {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  contact     String?      @db.VarChar(50)
  phone       String?      @db.VarChar(30)
  address     String?      @db.VarChar(200)
  remark      String?      @db.VarChar(200)
  status      Int          @default(1)
  groupId     Int?         @map("group_id") // 客户组织（归属，可移动）
  group       CustomerGroup? @relation(fields: [groupId], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  saleOrders  SaleOrder[]
  saleReturns SaleReturn[]
  tagLinks    CustomerTagLink[]

  @@index([name])
  @@index([groupId])
  @@map("customers")
}

// 客户组织（分类，客户归属单一组织，可移动；同组织/标签管理页维护）
model CustomerGroup {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  status    Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  customers Customer[]

  @@map("customer_groups")
}

// 客户标签（多对多）
model CustomerTag {
  id        Int               @id @default(autoincrement())
  name      String            @unique @db.VarChar(30)
  status    Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  links     CustomerTagLink[]

  @@map("customer_tags")
}

model CustomerTagLink {
  customerId Int         @map("customer_id")
  tagId      Int         @map("tag_id")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@map("customer_tag_links")
}

// ---------------------------------------------------------------------------
// 进货
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id                Int                 @id @default(autoincrement())
  orderNo           String              @unique @map("order_no") @db.VarChar(30)
  supplierId        Int                 @map("supplier_id")
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  status            PurchaseOrderStatus @default(pending)
  totalAmount       Decimal             @map("total_amount") @db.Decimal(14, 2)
  paidAmount        Decimal             @default(0) @map("paid_amount") @db.Decimal(14, 2)
  sourceSaleOrderId Int?                @map("source_sale_order_id") // 自动补货单：触发的售卖单
  sourceSaleOrder   SaleOrder?          @relation("AutoRestock", fields: [sourceSaleOrderId], references: [id])
  sourceType        SourceType          @default(manual) @map("source_type")
  remark            String?             @db.VarChar(200)
  operatorId        Int                 @map("operator_id")
  operator          User                @relation(fields: [operatorId], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")
  receivedAt        DateTime?           @map("received_at")
  voidedBy          Int?                @map("voided_by")
  voidedAt          DateTime?           @map("voided_at")
  voidReason        String?             @map("void_reason") @db.VarChar(200)

  items   PurchaseOrderItem[]
  returns PurchaseReturn[] // 原单关联的进货退货单

  @@index([supplierId])
  @@index([status])
  @@index([operatorId])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int           @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)
  unitId          Int           @map("unit_id")
  unit            Unit          @relation(fields: [unitId], references: [id])
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(14, 2)

  returnItems PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// 销售
// ---------------------------------------------------------------------------

model SaleOrder {
  id             Int             @id @default(autoincrement())
  orderNo        String          @unique @map("order_no") @db.VarChar(30)
  customerId     Int             @map("customer_id")
  customer       Customer        @relation(fields: [customerId], references: [id])
  status         SaleOrderStatus @default(confirmed)
  totalAmount    Decimal         @map("total_amount") @db.Decimal(14, 2)
  receivedAmount Decimal         @default(0) @map("received_amount") @db.Decimal(14, 2)
  remark         String?         @db.VarChar(200)
  operatorId     Int             @map("operator_id")
  operator       User            @relation(fields: [operatorId], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  voidedBy       Int?            @map("voided_by")
  voidedAt       DateTime?       @map("voided_at")
  voidReason     String?         @map("void_reason") @db.VarChar(200)

  items             SaleOrderItem[]
  autoRestockOrders PurchaseOrder[] @relation("AutoRestock") // 本单触发的自动补货进货单
  returns           SaleReturn[] // 原单关联的销售退货单

  @@index([customerId])
  @@index([status])
  @@index([operatorId])
  @@index([createdAt])
  @@map("sale_orders")
}

model SaleOrderItem {
  id          Int       @id @default(autoincrement())
  saleOrderId Int       @map("sale_order_id")
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   Int       @map("product_id")
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)
  unitId      Int       @map("unit_id")
  unit        Unit      @relation(fields: [unitId], references: [id])
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(14, 2)
  costAmount  Decimal   @map("cost_amount") @db.Decimal(14, 2) // 开单时成本快照 = 数量 × 当时 avg_cost

  returnItems SaleReturnItem[]

  @@index([saleOrderId])
  @@index([productId])
  @@map("sale_order_items")
}

// ---------------------------------------------------------------------------
// 退货
// ---------------------------------------------------------------------------

model PurchaseReturn {
  id              Int               @id @default(autoincrement())
  orderNo         String            @unique @map("order_no") @db.VarChar(30)
  purchaseOrderId Int               @map("purchase_order_id") // 关联原进货单
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  supplierId      Int               @map("supplier_id")
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  totalAmount     Decimal           @map("total_amount") @db.Decimal(14, 2) // 退货金额（应付冲减）
  remark          String?           @db.VarChar(200)
  operatorId      Int               @map("operator_id")
  operator        User              @relation(fields: [operatorId], references: [id])
  status          ReturnOrderStatus @default(confirmed)
  createdAt       DateTime          @default(now()) @map("created_at")
  voidedBy        Int?              @map("voided_by")
  voidedAt        DateTime?         @map("voided_at")
  voidReason      String?           @map("void_reason") @db.VarChar(200)

  items PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                  Int               @id @default(autoincrement())
  purchaseReturnId    Int               @map("purchase_return_id")
  purchaseReturn      PurchaseReturn    @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId Int               @map("purchase_order_item_id") // 关联原进货单分录，保证退数量受限
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  productId           Int               @map("product_id")
  product             Product           @relation(fields: [productId], references: [id])
  quantity            Decimal           @db.Decimal(12, 3)
  unitId              Int               @map("unit_id")
  unit                Unit              @relation(fields: [unitId], references: [id])
  unitPrice           Decimal           @map("unit_price") @db.Decimal(12, 2) // 退货价
  amount              Decimal           @db.Decimal(14, 2)

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model SaleReturn {
  id          Int               @id @default(autoincrement())
  orderNo     String            @unique @map("order_no") @db.VarChar(30)
  saleOrderId Int               @map("sale_order_id") // 关联原售卖单
  saleOrder   SaleOrder         @relation(fields: [saleOrderId], references: [id])
  customerId  Int               @map("customer_id")
  customer    Customer          @relation(fields: [customerId], references: [id])
  totalAmount Decimal           @map("total_amount") @db.Decimal(14, 2) // 退货金额（应收冲减）
  remark      String?           @db.VarChar(200)
  operatorId  Int               @map("operator_id")
  operator    User              @relation(fields: [operatorId], references: [id])
  status      ReturnOrderStatus @default(confirmed)
  createdAt   DateTime          @default(now()) @map("created_at")
  voidedBy    Int?              @map("voided_by")
  voidedAt    DateTime?         @map("voided_at")
  voidReason  String?           @map("void_reason") @db.VarChar(200)

  items SaleReturnItem[]

  @@index([saleOrderId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id              Int           @id @default(autoincrement())
  saleReturnId    Int           @map("sale_return_id")
  saleReturn      SaleReturn    @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleOrderItemId Int           @map("sale_order_item_id") // 关联原售卖单分录
  saleOrderItem   SaleOrderItem @relation(fields: [saleOrderItemId], references: [id])
  productId       Int           @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 3)
  unitId          Int           @map("unit_id")
  unit            Unit          @relation(fields: [unitId], references: [id])
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2) // 退货价
  amount          Decimal       @db.Decimal(14, 2)
  costAmount      Decimal       @map("cost_amount") @db.Decimal(14, 2) // 按原单成本快照回补库存成本

  @@index([saleReturnId])
  @@map("sale_return_items")
}

// ---------------------------------------------------------------------------
// 收付款
// ---------------------------------------------------------------------------

model Payment {
  id         Int              @id @default(autoincrement())
  orderNo    String           @unique @map("order_no") @db.VarChar(30) // PAY/POF + 日期 + 序号（文档 7.3）
  direction  PaymentDirection
  orderType  PaymentOrderType @map("order_type")
  orderId    Int              @map("order_id") // 关联单据（区分单据类型见 orderType）
  amount     Decimal          @db.Decimal(14, 2)
  method     PaymentMethod
  remark     String?          @db.VarChar(200)
  operatorId Int              @map("operator_id")
  operator   User             @relation(fields: [operatorId], references: [id])
  status     PaymentStatus    @default(confirmed)
  createdAt  DateTime         @default(now()) @map("created_at")
  voidedBy   Int?             @map("voided_by")
  voidedAt   DateTime?        @map("voided_at")
  voidReason String?          @map("void_reason") @db.VarChar(200)

  @@index([orderType, orderId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 库存流水（唯一库存账本）
// ---------------------------------------------------------------------------

model StockMovement {
  id         Int          @id @default(autoincrement())
  productId  Int          @map("product_id")
  product    Product      @relation(fields: [productId], references: [id])
  changeQty  Decimal      @map("change_qty") @db.Decimal(12, 3) // 正入负出
  beforeQty  Decimal      @map("before_qty") @db.Decimal(12, 3)
  afterQty   Decimal      @map("after_qty") @db.Decimal(12, 3)
  unitCost   Decimal      @map("unit_cost") @db.Decimal(12, 4)
  bizType    StockBizType @map("biz_type")
  bizOrderNo String       @map("biz_order_no") @db.VarChar(30)
  operatorId Int          @map("operator_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([bizOrderNo])
  @@map("stock_movements")
}
